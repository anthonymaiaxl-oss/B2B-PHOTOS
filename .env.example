# ---------------------------------------------------------------- obrigatório
# Senha da área da organização (/admin). Escolha uma senha longa.
ADMIN_PASSWORD=

# Credenciais OAuth do Google Cloud (tipo "Aplicativo da Web").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gerado uma única vez em /admin → "Conectar Google Drive".
GOOGLE_REFRESH_TOKEN=

# Pasta do Drive onde ficam os álbuns (cada subpasta = um álbum).
# O botão "Criar a pasta raiz" no /admin devolve este ID pronto.
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# ------------------------------------------------------------------- opcional
# URL pública do site (usada em Open Graph e no compartilhamento).
NEXT_PUBLIC_SITE_URL=https://b2-b-photos.vercel.app

# Assina o cookie de sessão do /admin. Sem isso, a própria ADMIN_PASSWORD assina
# (o que invalida as sessões abertas sempre que a senha muda).
ADMIN_SESSION_SECRET=
