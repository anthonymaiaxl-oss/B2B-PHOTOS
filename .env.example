# API Key do Google Cloud com a Google Drive API habilitada (somente leitura).
GOOGLE_DRIVE_API_KEY=

# URL pública do site (usada em Open Graph e no compartilhamento).
NEXT_PUBLIC_SITE_URL=https://conexoesb2b.vercel.app

# Deixe como "true" para usar dados de desenvolvimento em vez do Google Drive.
NEXT_PUBLIC_USE_MOCK=false
